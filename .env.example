SCALPFORGE_ENVIRONMENT=local
SCALPFORGE_TRADING_MODE=paper
SCALPFORGE_DATABASE_URL=postgresql+asyncpg://scalpforge:scalpforge@postgres:5432/scalpforge
SCALPFORGE_REDIS_URL=redis://redis:6379/0
SCALPFORGE_LOG_LEVEL=INFO
SCALPFORGE_MAX_RISK_PER_TRADE_PCT=0.25
SCALPFORGE_MAX_DAILY_LOSS_PCT=1.00
SCALPFORGE_MAX_DRAWDOWN_PCT=5.00
SCALPFORGE_MAX_SPREAD_BPS=8.0
SCALPFORGE_MAX_PRICE_AGE_MS=1500
SCALPFORGE_MIN_SIGNAL_SCORE=0.65
SCALPFORGE_MT4_BRIDGE_ENABLED=false
# Optional; required only for FRED/ALFRED macro ingestion. Never commit the real value.
FRED_API_KEY=
